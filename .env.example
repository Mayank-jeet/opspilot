# Copy this file to .env and fill it in. Never commit .env.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini

# Deployment only (leave unset for local development)
# DEMO_KEY=choose-a-password          # required in the X-Demo-Key header for task/simulation endpoints
# CORS_ORIGINS=https://your-frontend.onrender.com   # comma-separated, no trailing slash
# INTERNAL_BASE_URL=                  # optional; defaults to http://127.0.0.1:$PORT
